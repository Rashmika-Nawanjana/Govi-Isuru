# Where the bot reaches the API (inside the compose network)
BACKEND_URL=http://backend:5000

# Shared secret for /api/whatsapp/internal/* - must match the server's value
WHATSAPP_BOT_KEY=

# Guards GET /bot/qr so the pairing code is not world-readable
BOT_ADMIN_KEY=

# International format, no +, no leading zero: 077 123 4567 -> 94771234567
BOT_PHONE_NUMBER=

# Admin/health port inside the container
BOT_PORT=7000

# Public site, used in deep links sent to farmers
FRONTEND_URL=https://govi-isuru.rashmika.dev

# Outbox pacing - do not lower without reading the ban-risk notes
OUTBOX_INTERVAL_MS=1500
OUTBOX_JITTER_MS=600
