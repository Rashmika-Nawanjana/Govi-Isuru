JWT_SECRET=your-jwt-secret-key-min-32-chars
REFRESH_TOKEN_SECRET=your-refresh-token-secret-min-32-chars
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/dbname
PORT=5000
NEWS_API_KEY=
WEATHER_API_KEY=
HUGGINGFACE_API_TOKEN=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
GMAIL_USER=your-gmail@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000

# Daily.co video consultations (https://dashboard.daily.co/developers)
DAILY_API_KEY=
# Optional join window overrides (minutes)
VIDEO_JOIN_EARLY_MINUTES=30
VIDEO_JOIN_LATE_MINUTES=120

# ====== WHATSAPP BOT (Baileys) ======
# Shared secret between the server and the bot container. The deploy workflow
# generates one automatically if it is missing.
WHATSAPP_BOT_KEY=
# Guards the pairing QR at /bot/qr?key=... Scanned once, by the team.
BOT_ADMIN_KEY=
# International format, no + and no leading zero: 077 123 4567 -> 94771234567
BOT_PHONE_NUMBER=
# Shared account used for guests who message the bot without a Govi Isuru login
WHATSAPP_DEMO_USERNAME=demo-judge
